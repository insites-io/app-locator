{%- parse_json location -%}{}{%- endparse_json -%}
{%- parse_json data -%}{}{%- endparse_json -%}
{%- assign distance = query_params.distance | default: 5 | plus: 0 -%}
{%- assign page = query_params.page | default: 1 | plus: 0 -%}
{%- assign size = query_params.size | default: 20 | plus: 0 -%}

{%- if query_params.lng and query_params.lat -%}
    {%- parse_json location -%}
        {
            "type": "Point",
            "coordinates": [{{ query_params.lng }}, {{ query_params.lat }}]
        }
    {%- endparse_json -%}

    {%- graphql data = "modules/locator/locations/search_locations", 
        page: page,
        size: size,
        point: location, 
        distance: distance,
        id: id,
        date_from: date_from,
        date_to: date_to,
        external_id: external_id -%}
{%- else -%}
    {%- graphql data = "modules/locator/locations/get_locations", 
        page: page,
        size: size,
        id: id,
        date_from: date_from,
        date_to: date_to,
        external_id: external_id -%}
{%- endif -%}

{% parse_json response %}
    {{ data | fetch: "items" }}
{% endparse_json %}

{%- if response != blank -%} 
    {%- assign status = 200 -%}
{%- else -%}
    {%- assign status = 400 -%}
{%- endif -%}

{%- include "modules/insites_core/functions/insites_response_util", 
    data: data, 
    status: status -%}