{%- liquid 

    if item.is_open_on_sunday 
        if item.sunday_opening_time and item.sunday_closing_time 
            capture sunday_sched 
                echo item.sunday_opening_time | date: "%l:%M %p" | append: " -" 
                echo item.sunday_closing_time  | date: "%l:%M %p"
            endcapture
        else
            assign sunday_sched = "Open"
        endif
    else
        assign sunday_sched = "Closed"
    endif
    assign sunday_item = '{}' | parse_json
    assign sunday_item = sunday_item | add_hash_key: 'time', sunday_sched
    assign sunday_item = sunday_item | add_hash_key: 'notes', item.sunday_notes

    if item.is_open_on_monday 
        if item.monday_opening_time and item.monday_closing_time 
            capture monday_sched
                echo item.monday_opening_time | date: "%l:%M %p" | append: " -"
                echo item.monday_closing_time  | date: "%l:%M %p" 
