    assign saturday_item = saturday_item | add_hash_key: 'time', saturday_sched
    assign saturday_item = saturday_item | add_hash_key: 'notes', item.saturday_notes

    assign schedule = '{}' | parse_json
    assign schedule = schedule | add_hash_key: 'sunday', sunday_item
    assign schedule = schedule | add_hash_key: 'monday', monday_item
    assign schedule = schedule | add_hash_key: 'tuesday', tuesday_item
    assign schedule = schedule | add_hash_key: 'wednesday', wednesday_item
    assign schedule = schedule | add_hash_key: 'thursday', thursday_item
    assign schedule = schedule | add_hash_key: 'friday', friday_item
    assign schedule = schedule | add_hash_key: 'saturday', saturday_item

    return schedule

-%}