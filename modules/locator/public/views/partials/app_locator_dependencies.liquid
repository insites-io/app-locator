{% comment %} Fonts {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cabin:wght@300;400;700&display=swap" rel="stylesheet">

<link rel="preload" as="script" href="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.0/axios.min.js" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.0/axios.min.js"></script>

{%- if context.environment == "staging" -%}
    <link rel="preload" as="style" href="{{ 'modules/locator/styles/locator_app.css' | asset_url }}" /> 
    <link rel="stylesheet" href="{{ 'modules/locator/styles/locator_app.css' | asset_url }}" /> 
{%- else -%}
    {%- comment -%} Minified version will be used in the production environment {%- endcomment -%}
    <link rel="preload" as="style" href="{{ 'modules/locator/styles/locator_app.min.css' | asset_url }}" /> 
    <link rel="stylesheet" href="{{ 'modules/locator/styles/locator_app.min.css' | asset_url }}" /> 
{%- endif -%}



{%- comment -%}
-- Local script copy of markercluster.js
-- https://developers.google.com/maps/documentation/javascript/marker-clustering
<script src="{{ 'modules/locator/scripts/googleMarkCluster.js' | asset_url }}"></script> 
{%- endcomment -%}

<script src="https://developers.google.com/maps/documentation/javascript/examples/markerclusterer/markerclusterer.js"></script>

{%- if context.environment == "staging" -%}
    <script src="{{ 'modules/locator/services/insitesLocatorServices.js' | asset_url }}"></script>
    <script src="{{ 'modules/locator/scripts/customLocatorUI.js' | asset_url }}"></script>
    <script src="{{ 'modules/locator/scripts/customLocatorMap.js' | asset_url }}"></script> 
{%- else -%}
    {%- comment -%} Minified version will be used in the production environment {%- endcomment -%}
    <script src="{{ 'modules/locator/services/insitesLocatorServices.min.js' | asset_url }}"></script>
    <script src="{{ 'modules/locator/scripts/customLocatorUI.min.js' | asset_url }}"></script>
    <script src="{{ 'modules/locator/scripts/customLocatorMap.min.js' | asset_url }}"></script> 
{%- endif -%}





