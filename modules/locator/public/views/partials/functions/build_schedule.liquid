            capture friday_sched
                echo item.friday_opening_time | date: "%l:%M %p" | append: " -"
                echo item.friday_closing_time  | date: "%l:%M %p"
            endcapture
        else
            assign friday_sched = item.friday_notes | default: "Open"
        endif
    else
        assign friday_sched = item.friday_notes | default: "Closed"
    endif
    assign friday_item = '{}' | parse_json
    assign friday_item = friday_item | add_hash_key: 'time', friday_sched
    assign friday_item = friday_item | add_hash_key: 'notes', item.friday_notes

