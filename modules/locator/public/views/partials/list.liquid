{%- assign page_title = "Locations | Insites" -%}
{%- assign meta_title = "Locations | Insites" -%}
{%- assign meta_description = "Locations | Insites Demo Description" -%}
{%- assign canonical_url = "" -%}
{%- export page_title, meta_title, meta_description, canonical_url, namespace: "page_metadata" -%}

<div class="locations-list-container">
    {%- comment -%}Locations list view {%- endcomment -%}
    {% comment %} {%- content_for 'title' -%}{{ context.page.metadata.page_title }}{%- endcontent_for -%}
    {%- content_for 'meta_description' -%}{{ context.page.metadata.meta_description }}{%- endcontent_for -%} {% endcomment %}

    <section class="title-banner bg-main">
        <div class="wrapper">
            <div class="grid-container">
                <div class="spacer xxx-large"></div>
                <h1 class="color-inv">Search Locations</h1>
                <div class="spacer xxx-large"></div>
            </div>
        </div>
    </section>

    {% graphql data = 'modules/website/trigger_api_call', name: 'modules/client/get_google_maps_api_key' %}

    {%- assign api_key = data.items.response.body | parse_json | dig: 'items','results' | first | dig: 'key' -%}

    <div class="locations-list-wrapper wrapper">
        <div class="grid-container">
            <div class="grid-x grid-padding-x">
                <div class="large-4 medium-4 small-12 cell search-options-wrapper">
                    <div class="spacer xxxx-large"></div>
                    <div class="spacer"></div>

                    <ins-input label="Search" id="address-search"
                        {% if api_key == blank %}
                        readonly placeholder="Google API key not yet configured."
                        {% else %}
                        placeholder="Enter your Suburb or Post Code"
                        error-message="Please enter a valid suburb or post code."
                        icon="icon-location-arrow" icon-event
                        {% endif %}>
                    </ins-input>
                    
                    <ins-select id="search-distance" label="Location within:">
                        <ins-select-option label="5km" value="5" default></ins-select-option>
                        <ins-select-option label="10km" value="10"></ins-select-option>
                        <ins-select-option label="15km" value="15"></ins-select-option>
                        <ins-select-option label="20km" value="20"></ins-select-option>
                    </ins-select>

                    <ins-button label="Search"
                        {% if api_key == blank %}
                        disabled
                        {% endif %}
                        id="search-submit"
                        solid color="blue"
                        icon="icon-search">
                    </ins-button>

                    <div class="spacer"></div>

                    <ins-button label="Hide Filters"
                        id="advanced-filter-btn"
                        color="blue"
                        icon="icon-sliders">
                    </ins-button>

                    <div id="location-filters-container">
                        <div class="spacer"></div>
                        <hr>
                        <div class="spacer"></div>
                        {%- include "modules/insites_locator/controllers/utilities/advanced_filters/get_filter_options" -%}
                        
                        {% assign filter_options = '{}' | parse_json %}
                        {% for filter_option in context.exports.filter_options._system_field_names %}
                            {% assign _data = '{}' | parse_json %}
                            {% capture var %}filter-{{ forloop.index }}{% endcapture %}
                            {% assign filter_options = filter_options | add_hash_key: var, _data %}
                            {% assign filter_options[var] = filter_options[var] | add_hash_key: "field_name", filter_option[0] %}
                            {% if filter_option[1].options != blank %}
                                {% assign filter_options[var] = filter_options[var] | add_hash_key: "field_options", filter_option[1].options | parse_json %}
                            {% endif %}
                        {% endfor %}

                        <div class="filter-label">
                            {{ filter_options["filter-1"]["field_name"] }}
                        </div>
                        <div class="spacer small"></div>
                        {% if filter_options["filter-1"]["field_options"] != blank %}
                            {% for option in filter_options["filter-1"]["field_options"] %}
                                <ins-checkbox 
                                    name="filter_1" 
                                    label="{{ option.value }}" 
                                    value="{{ option.uuid }}">
                                </ins-checkbox>
                            {% endfor %}
                        {% else %}
                            <p class="empty-filter-text">
                                No {{ filter_options["filter-1"]["field_name"] }} filter added yet.
                            </p>
                        {% endif %}
                        <div class="spacer"></div>
                        <hr>
                        <div class="spacer"></div>

                        <ins-select
                            id="filter_2"
                            label="{{ filter_options["filter-2"]["field_name"] }}" 
                            multiple
                            searchable>
                            {% for option in filter_options["filter-2"]["field_options"] %}
                                <ins-select-option 
                                    name="filter-2" 
                                    label="{{ option.value }}"
                                    value="{{ option.uuid }}">
                                </ins-select-option>
                            {% endfor %}
                        </ins-select>
                    </div>
                    <div class="spacer xxxx-large"></div>
                </div>

                <div class="large-8 medium-8 small-12 cell search-results-wrapper">
                    <div class="spacer xxxx-large"></div>
                    <div id="view-type-buttons-wrapper" class="grid-x align-right align-middle spacer">
                        <span>View:</span>
                        <div class="view-type-buttons grid-x">
                            <div id="map-view" class="type-button icon-map active"></div>
                            <div id="grid-view" class="type-button icon-grid"></div>
                            <div id="list-view" class="type-button icon-list"></div>
                        </div>
                    </div>
                    <div id="search-results">
                        <div id="locator-map">
                            <div id="ins-locator-map"></div>
                            <div class="spacer xxx-large"></div>
                        </div>
                        
                        <div id="results-loader">
                            <ins-loader
                                state-title="Processing"
                                state-message="Please wait, we're processing your request."
                                state-icon="processing"
                                image-source="{{ 'modules/locator/images/loader.gif' | asset_url }}"
                                >
                            </ins-loader>
                        </div>

                        <div id="results-map">
                            <ul id="results-list"></ul>
                        </div>
                        <ins-table
                            id="locationsTable"
                            static-table
                            without-search
                            no-wrap>
                        </ins-table>
                    </div>
                    <div class="spacer xxxx-large"></div>
                </div>
            </div>
        </div>
    </div>
    <!-- Insites Locator UI Dependencies -->
    {%- include 'modules/locator/app_locator_dependencies' -%}
    <!-- END Insites Locator UI Dependencies  -->

    {%- comment -%}
        Location enquiry form drawer
    {%- endcomment -%}
    {%- include 'modules/locator/locator_form_drawer' -%}
</div>